# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# App Store review accounts. Comma-separated E.164 numbers that skip Twilio and
# accept FLAKY_DEMO_CODE instead of a real SMS code; we never text them.
# Leave blank to disable. Rotate the code after review.
# FLAKY_DEMO_CODE must be EXACTLY 6 DIGITS — the code input strips non-digits
# and caps at 6, so anything else cannot be typed in and sign-in is impossible.
# Numbers must pass libphonenumber validation — the NANP 555-01xx fiction range
# works (e.g. +12025550143,+13105550123); +15551234567 and +447700900xxx do not.
FLAKY_DEMO_PHONES=
FLAKY_DEMO_CODE=
